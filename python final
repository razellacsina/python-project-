def relational_operators():
    print("==== 1 relational operators ====")
    print("these operator is compare two values")
    print("example")
    print("== is equal to")
    print("!= is not equal to")
    print("> is greater than")
    print("< is less than")
    print(">= is greater than or equal to")
    print("<= is less than or equal to")

    a = int(input("enter first number: "))
    b = int(input("enter second number: "))

    print("a == b:", a == b)
    print("a != b:", a != b)
    print("a > b:", a > b)
    print("a < b:", a < b)
    print("a >= b:", a >= b)
    print("a <= b:", a <= b)


def conditional_statements():
    print("==== 2 the if statement ====")
    print("if statement is used when the condition is true")
    print("example")
    print("age = 18")
    print("if age >= 18:")
    print("    print('you are adult')")

    age = int(input("enter your age: "))

    if age >= 18:
        print("you are adult")

    print("==== 3 the if-else statement ====")
    print("if else statement is used when there are two possible results")
    print("example")
    print("if age >= 18:")
    print("print('you are adult')")
    print("else:")
    print("print('you are not adult')")

    age = int(input("enter your age: "))

    if age >= 18:
        print("you are adult")
    else:
        print("you are not adult")

    print("==== 4 the if-elif-else statement ====")
    print("if elif else is used when there are many conditions")
    print("example")
    print("if grade >= 90:")
    print("print('excellent')")
    print("elif grade >= 75:")
    print("print('passed')")
    print("else:")
    print("    print('failed')")

    grade = int(input("enter your grade: "))

    if grade >= 90:
        print("excellent")
    elif grade >= 75:
        print("passed")
    else:
        print("failed")

    print("==== 5 nested condition ====")
    print("nested condition is an if statement inside another if statement")
    print("example")
    print("if age >= 18:")
    print("if age <= 30:")
    print("print('you are allowed')")

    age = int(input("enter your age: "))

    if age >= 18:
        if age <= 30:
            print("you are allowed")
        else:
            print("you are above 30")
    else:
        print("you are too young")


